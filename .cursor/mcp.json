{
  "mcpServers": {
    "redmed": {
      "command": "node",
      "args": [
        "mcp/redmed-mcp/bin/redmed-mcp.mjs"
      ],
      "env": {
        "REDMED_SSH_HOST": "2.25.249.204",
        "REDMED_SSH_KEY": "${env:HOME}/.ssh/hostinger_vps",
        "REDMED_SUPABASE_REF": "mohxobgyjkcmkqxijgeg",
        "HOSTINGER_API_TOKEN": "${env:HOSTINGER_API_TOKEN}",
        "GITHUB_TOKEN": "${env:GITHUB_TOKEN}"
      }
    },
    "redmed-vps": {
      "command": "mcp/bin/run-stdio.sh",
      "env": {
        "REDMED_EXEC_MODE": "ssh",
        "REDMED_VPS_HOST": "hostinger-vps",
        "REDMED_VPS_USER": "root",
        "REDMED_VPS_IDENTITY": "${env:HOME}/.ssh/hostinger_vps",
        "HOSTINGER_API_TOKEN": "${env:HOSTINGER_API_TOKEN}",
        "SUPABASE_URL": "${env:SUPABASE_URL}",
        "SUPABASE_PUBLISHABLE_KEY": "${env:SUPABASE_PUBLISHABLE_KEY}",
        "SUPABASE_SECRET_KEY": "${env:SUPABASE_SECRET_KEY}",
        "REDMED_MCP_TOKEN": "${env:REDMED_MCP_TOKEN}"
      }
    },
    "redmed-remote": {
      "url": "https://mcp.redmed.live/mcp",
      "headers": {
        "Authorization": "Bearer ${env:REDMED_MCP_TOKEN}"
      }
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${env:CURSOR_GITHUB_TOKEN}"
      }
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "cloudflare-docs": {
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "cloudflare-bindings": {
      "url": "https://bindings.mcp.cloudflare.com/mcp"
    },
    "cloudflare-builds": {
      "url": "https://builds.mcp.cloudflare.com/mcp"
    },
    "cloudflare-observability": {
      "url": "https://observability.mcp.cloudflare.com/mcp"
    }
  }
}
