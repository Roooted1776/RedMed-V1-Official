# Hostinger Apache — AASA Content-Type + basic static hints.
# Cloudflare _headers is ignored on Hostinger origin; this file is staged into
# dist/passerby by scripts/stage-site.sh when present at repo root.

<IfModule mod_headers.c>
  <Files "apple-app-site-association">
    Header set Content-Type "application/json"
  </Files>
</IfModule>

<IfModule mod_mime.c>
  AddType application/json .well-known/apple-app-site-association
</IfModule>

# Serve AASA without forcing .json extension
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^apple-app-site-association$ - [T=application/json]
  RewriteRule ^\.well-known/apple-app-site-association$ - [T=application/json]

  # Root + legacy stub URLs -> the Assist shell, server-side (same list as
  # _redirects, which only Cloudflare Pages reads). Without this, redmed.live/
  # answers 200 and only a JS stub redirects, so link previews and no-JS
  # browsers stop on "Open emergency card". #d= never reaches the server; the
  # browser keeps it across the 301. Query strings pass through.
  RewriteRule ^(index\.html|tapper\.html|card\.html|get\.html|redmed-emergency\.html|get/?|get/index\.html)?$ /tapper/ [R=301,L]
</IfModule>
