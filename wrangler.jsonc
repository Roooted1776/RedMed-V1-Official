// NON-PRODUCT LEFTOVER — do not recreate Worker redmed-emergency for bands.
// Product write base is Hostinger static https://redmed.live/tapper/ (docs/domain.md).
// Kept only so historical device-aspect HTMLRewriter tooling still builds locally.
// Stage with the same Assist staging script as Hostinger (scripts/stage-site.sh).
// Worker injects data-device from UA / CF-Device-Type; client refines with viewport aspect.
{
  "name": "redmed-emergency",
  "main": "worker/index.js",
  "account_id": "a2d8a74738a0280eb9d5a3e77acd59ea",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "bash scripts/stage-site.sh"
  },
  "assets": {
    "directory": "./dist/passerby",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/tapper",
      "/tapper/",
      "/tapper/index.html",
      "/card.html",
      "/get.html",
      "/get",
      "/get/"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
