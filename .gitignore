.derivedData/

# Local Cursor user sync tarballs (may include MCP tokens). See docs/DUAL-MAC.md.
.local/

# macOS
.DS_Store
**/.DS_Store

# Never commit key material — even empty placeholders invite real secrets.
**/google-api-key
*.pem
*.p12
*.mobileprovision

# Xcode — per-user state. Committing these makes every project open replay a
# stale window/editor layout and makes every merge conflict on a binary blob.
# Local wearer-sync key. Copy owner/Config/Supabase.xcconfig.example; never commit it.
**/Supabase.xcconfig
Secrets.xcconfig
*.local.xcconfig
xcuserdata/
*.xcuserstate
*.xcuserdatad/
DerivedData/
build/

# Keep shared schemes tracked so Xcode doesn't regenerate them on open:
!*.xcodeproj/xcshareddata/
!*.xcodeproj/xcshareddata/xcschemes/
!*.xcodeproj/xcshareddata/xcschemes/*.xcscheme

# Do not reintroduce removed staging / debug dumps on main.
uploads/
screenshots/
compliance/
Screenshot*.png
redmed-*.png
support.js
ios-frame.jsx
.tmp_*.png

# Hostinger staging output (scripts/stage-site.sh)
dist/

node_modules/

# RedMed MCP local secrets (never commit keys)
mcp/.env
mcp/.env.local

# Claude Code local MCP (may embed Bearer tokens)
.mcp.json

# Local scratch previews (not product output)
Claude outputs/
tapper/index.preview.html
